generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Role {
  CUSTOMER
  MERCHANT
  RIDER
  ADMIN
}

enum MerchantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  PROVIDER_A
  PROVIDER_B
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  email             String?     @unique
  phone             String?     @unique
  passwordHash      String
  firstName         String
  lastName          String
  status            UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  roles             UserRole[]
  customerProfile   CustomerProfile?
  merchantProfile   Merchant?
  riderProfile      RiderProfile?
  addresses         Address[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  notifications     Notification[]
  auditEvents       AuditLog[]  @relation("AuditActor")

  @@index([status])
  @@index([createdAt])
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  assignedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CustomerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
}

model Merchant {
  id                 String         @id @default(uuid()) @db.Uuid
  ownerUserId        String         @unique @db.Uuid
  name               String
  slug               String         @unique
  description        String?
  phone              String?
  email              String?
  addressLine        String?
  city               String?
  region             String?
  countryCode        String         @default("GH")
  latitude           Decimal?       @db.Decimal(10, 7)
  longitude          Decimal?       @db.Decimal(10, 7)
  status             MerchantStatus @default(PENDING_APPROVAL)
  isPublic           Boolean        @default(false)
  acceptsOrders      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  owner              User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  categories         MerchantCategoryLink[]
  operatingHours     MerchantOperatingHour[]
  products           Product[]
  deliveryZones      DeliveryZone[]
  orders             Order[]

  @@index([status, isPublic])
  @@index([city, region])
  @@index([name])
}

model MerchantCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())
  merchants   MerchantCategoryLink[]
}

model MerchantCategoryLink {
  merchantId String @db.Uuid
  categoryId String @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([merchantId, categoryId])
  @@index([categoryId])
}

model MerchantOperatingHour {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  dayOfWeek   Int
  opensAt     String?
  closesAt    String?
  isClosed    Boolean  @default(false)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
  @@index([merchantId])
}

model DeliveryZone {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  // Store polygon/geometry in a later PostGIS migration if geospatial queries are required.
  boundaryGeoJson Json?
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, isActive])
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  merchantId    String        @db.Uuid
  name          String
  slug          String
  description   String?
  sku           String?
  unitPrice     Decimal       @db.Decimal(12, 2)
  currency      String        @default("GHS") @db.VarChar(3)
  status        ProductStatus @default(DRAFT)
  isAvailable   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  categories    ProductCategoryLink[]
  inventory     Inventory?
  orderItems    OrderItem[]

  @@unique([merchantId, slug])
  @@unique([merchantId, sku])
  @@index([merchantId, status, isAvailable])
  @@index([name])
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  parentId    String?  @db.Uuid
  parent      ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductCategory[] @relation("CategoryTree")
  products    ProductCategoryLink[]
}

model ProductCategoryLink {
  productId  String @db.Uuid
  categoryId String @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Inventory {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @unique @db.Uuid
  quantityOnHand Int      @default(0)
  quantityHeld   Int      @default(0)
  lowStockLevel  Int      @default(0)
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quantityOnHand])
}

model Address {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  label          AddressType @default(OTHER)
  recipientName  String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  region         String?
  countryCode    String      @default("GH")
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  deliveryNotes  String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([userId, isDefault])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique
  customerId      String      @db.Uuid
  merchantId      String      @db.Uuid
  deliveryAddressId String    @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @default("GHS") @db.VarChar(3)
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal     @db.Decimal(12, 2)
  customerNote    String?
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  deliveryAddress Address @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  delivery        Delivery?

  @@index([customerId, placedAt])
  @@index([merchantId, status, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @db.Uuid
  productId       String  @db.Uuid
  productName     String
  skuSnapshot     String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedBy   String?     @db.Uuid
  reason      String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([changedBy])
}

model Payment {
  id                 String         @id @default(uuid()) @db.Uuid
  orderId            String         @db.Uuid
  provider           PaymentProvider
  providerReference  String?
  idempotencyKey     String?        @unique
  amount             Decimal        @db.Decimal(12, 2)
  currency           String         @default("GHS") @db.VarChar(3)
  status             PaymentStatus  @default(INITIATED)
  initiatedAt        DateTime       @default(now())
  confirmedAt        DateTime?
  updatedAt          DateTime       @updatedAt
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions       PaymentTransaction[]

  @@index([orderId, initiatedAt])
  @@index([provider, providerReference])
  @@index([status, initiatedAt])
}

model PaymentTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @db.Uuid
  providerEventId   String?
  eventType         String
  verified          Boolean  @default(false)
  payload           Json?
  receivedAt        DateTime @default(now())
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, providerEventId])
  @@index([receivedAt])
}

model RiderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  verificationStatus String @default("PENDING")
  isAvailable     Boolean  @default(false)
  vehicleType     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries      Delivery[]

  @@index([verificationStatus, isAvailable])
}

model Delivery {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @db.Uuid
  riderId        String?        @db.Uuid
  status         DeliveryStatus @default(PENDING_ASSIGNMENT)
  assignedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rider          RiderProfile?  @relation(fields: [riderId], references: [id], onDelete: Restrict)
  trackingEvents DeliveryTrackingEvent[]

  @@index([riderId, status])
  @@index([status, createdAt])
}

model DeliveryTrackingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  deliveryId  String   @db.Uuid
  status      DeliveryStatus
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  note        String?
  recordedAt  DateTime @default(now())
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus @default(QUEUED)
  subject     String?
  body        String
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
